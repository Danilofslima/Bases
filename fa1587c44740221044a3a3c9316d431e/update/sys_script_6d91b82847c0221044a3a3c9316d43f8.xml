        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var gr = new GlideRecord(current.getTableName());

    // Check if a base with the same name already exists
    gr.addQuery('base_name', current.base_name);
    gr.query();
    if (gr.next()) {
        gs.addErrorMessage('A base with the same name already exists: ' + current.base_name);
        current.setAbortAction(true);
        return;
    }

    // Check if another record with the same city + state exists
    gr.initialize();  // Reset the GlideRecord object
    gr.addQuery('city', current.city);
    gr.addQuery('state', current.state);
    gr.query();
    if (gr.next()) {
        gs.addErrorMessage('A base is already registered in ' + current.city + '/' + current.state);
        current.setAbortAction(true);
    }

})(current, previous);
]]></script>
