        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var grBases = new GlideRecord('x_1488662_bases_bases');
    grBases.addQuery('sys_id', current.base);
    grBases.query();

    if (grBases.next()) { 
        var maxCapacity = parseInt(grBases.getValue('max_capacity'), 10);

        if (maxCapacity === 0) {
            gs.addErrorMessage('The base ' + grBases.getDisplayValue('base_name') + ' is already at full capacity: ' );
            current.setAbortAction(true);
        } else {
            gs.addInfoMessage('Record created');
        }
    }

})(current, previous);
